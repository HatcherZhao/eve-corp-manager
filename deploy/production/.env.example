# 此文件只说明变量；复制为 .env 后填写真实值，禁止提交 .env。
# 每次发布替换为仓库 VERSION 的值，例如 0.1.0。
IMAGE_TAG=0.1.0
APP_BIND_IP=127.0.0.1
APP_URL=https://eve.example.com
EVE_IMAGE_CACHE_HOST_DIR=./data/eve-images

# MySQL 与 Redis 由部署者提供；不要使用生产 root 账户。
DB_HOST=mysql.example.internal
DB_PORT=3306
DB_NAME=eve_corp_manager
DB_USER=eve
DB_PWD=
REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_PWD=
REDIS_DB=14

# 首次启动前必须填写；字段密钥必须与既有 eve_corp_manager 数据库一致。
SA_JWT_SECRET=
FIELD_AES_KEY=
FIELD_RSA_PUBLIC_KEY=
FIELD_RSA_PRIVATE_KEY=
BOOTSTRAP_ADMIN_PASSWORD=

# 国服 Swagger 公共客户端默认值可用；未提供 secret 时保持为空。
EVE_SERENITY_CLIENT_ID=bc90aa496a404724a93f41b4f4e97761
EVE_SERENITY_CLIENT_SECRET=
